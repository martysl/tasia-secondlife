<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="all"
 height="440"
 layout="topleft"
 left="1"
 top="1"
 width="540"
 label="Tasia"
 name="tasia">

    <text
     type="string"
     length="1"
     follows="left|top"
     height="20"
     layout="topleft"
     left="20"
     top="15"
     name="tasia_chat_label"
     font="SansSerifBold"
     font-size="12"
     width="500">
     Chat Preview Features
    </text>

    <text
     type="string"
     length="1"
     follows="left|top"
     height="14"
     layout="topleft"
     left="35"
     top_pad="5"
     name="tasia_chat_desc"
     font="SansSerif"
     width="480">
     Show inline previews when hovering supported URLs in chat history.
    </text>

    <check_box
     control_name="TasiaYouTubeChatPreview"
     follows="left|top"
     height="16"
     label="Enable YouTube chat previews"
     layout="topleft"
     left="35"
     top_pad="10"
     name="TasiaYouTubeChatPreview"
     width="400" />

    <check_box
     control_name="TasiaImageChatPreview"
     follows="left|top"
     height="16"
     label="Enable image chat previews"
     layout="topleft"
     left="35"
     top_pad="5"
     name="TasiaImageChatPreview"
     width="400" />

    <check_box
     control_name="TasiaAnimatedGifChatPreview"
     follows="left|top"
     height="16"
     label="Enable animated GIF (GIPHY) chat previews"
     layout="topleft"
     left="35"
     top_pad="5"
     name="TasiaAnimatedGifChatPreview"
     width="400" />

    <text
     type="string"
     length="1"
     follows="left|top"
     height="20"
     layout="topleft"
     left="20"
     top_pad="20"
     name="tasia_anim_label"
     font="SansSerifBold"
     font-size="12"
     width="500">
     Animation Priority Overrides
    </text>

    <text
     type="string"
     length="1"
     follows="left|top"
     height="14"
     layout="topleft"
     left="35"
     top_pad="5"
     name="tasia_anim_desc"
     font="SansSerif"
     width="480">
     Force a priority (1-4) for specific animations so they win over lower-priority animations (e.g. AOs). Enter the animation UUID and a priority, then press Add.
    </text>

    <check_box
     control_name="TasiaAnimPriorityEnabled"
     follows="left|top"
     height="16"
     label="Enable animation priority overrides"
     layout="topleft"
     left="35"
     top_pad="10"
     name="TasiaAnimPriorityEnabled"
     width="400" />

    <line_editor
     follows="left|top"
     height="20"
     layout="topleft"
     left="35"
     top_pad="10"
     name="tasia_anim_uuid"
     width="330" />

    <spinner
     allow_text_entry="true"
     decimal_digits="0"
     follows="left|top"
     height="20"
     increment="1"
     initial_val="4"
     layout="topleft"
     left_pad="6"
     max_val="4"
     min_val="1"
     name="tasia_anim_priority"
     top_pad="10"
     width="50" />

    <button
     follows="left|top"
     height="20"
     label="Add"
     layout="topleft"
     left_pad="6"
     name="tasia_anim_add"
     top_pad="10"
     width="60"
     function="Pref.TasiaAnimAdd" />

    <scroll_list
     follows="all"
     height="100"
     layout="topleft"
     left="35"
     top_pad="10"
     name="tasia_anim_list"
     width="475">
      <column
       dynamicwidth="true"
       label="Animation UUID"
       name="uuid" />
      <column
       dynamicwidth="true"
       label="Priority"
       name="priority" />
    </scroll_list>

    <button
     follows="left|top"
     height="20"
     label="Remove Selected"
     layout="topleft"
     left="35"
     top_pad="5"
     name="tasia_anim_remove"
     width="130"
     function="Pref.TasiaAnimRemove" />

    <text
     type="string"
     length="1"
     follows="left|top"
     height="14"
     layout="topleft"
     left="35"
     top_pad="5"
     name="tasia_anim_status"
     font="SansSerif"
     width="475" />

    <string name="invalid_uuid">
     Invalid UUID. Enter a full animation UUID.
    </string>

</panel>
